# Local OpenAI-compatible provider configuration.
# Copy this file to apiconfig/<benchmark>.env and fill in your own values.
# Do not commit the resulting .env file.

DEV_API_BASE=https://your-openai-compatible-endpoint/v1
DEV_API_KEY=replace-with-your-key
DEV_MODEL=replace-with-your-model
META_TEAM_MODEL=replace-with-your-model
